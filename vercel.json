{
  "version": 2,
  "builds": [
    {
      "src": "back-end/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "back-end/server.js"
    },
    {
      "source": "/",
      "destination": "front-end/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "front-end/$1"
    }
  ]
}